{
  "mcpServers": {
    "nullify": {
      "command": "bash",
      "args": [
        ".claude/mcp/with-op-env.sh",
        "NULLIFY_CREDENTIALS_JSON",
        "--",
        "bash", ".claude/mcp/nullify-serve.sh"
      ],
      "env": {
        "NULLIFY_HOST": "${NULLIFY_HOST:-scrut.nullify.ai}"
      }
    },
    "sentinelone": {
      "command": "bash",
      "args": [
        ".claude/mcp/with-op-env.sh",
        "PURPLEMCP_CONSOLE_TOKEN", "PURPLEMCP_CONSOLE_BASE_URL",
        "--",
        "uvx", "--from", "./third_party/purple-mcp", "purple-mcp", "--mode", "stdio"
      ]
    },
    "latent-defense": {
      "command": "bash",
      "args": [
        ".claude/mcp/with-op-env.sh",
        "LATENT_DEFENSE_URL", "LATENT_DEFENSE_API_KEY",
        "--",
        "latent-defense-mcp"
      ]
    },
    "aws": {
      "command": "bash",
      "args": [
        ".claude/mcp/with-op-env.sh",
        "SCRUT_AWS_ACCESS_KEY_ID", "SCRUT_AWS_SECRET_ACCESS_KEY",
        "SCRUT_AWS_SESSION_TOKEN", "SCRUT_AWS_REGION",
        "--",
        "bash", ".claude/mcp/aws-serve.sh"
      ]
    }
  }
}
