{
  "mcpServers": {
    "nullify": {
      "command": "bash",
      "args": [
        ".claude/mcp/with-op-env.sh",
        "NULLIFY_TOKEN",
        "--",
        "go", "run", "./cmd/cli", "mcp", "serve"
      ],
      "env": {
        "NULLIFY_HOST": "${NULLIFY_HOST:-scrut.nullify.ai}"
      }
    },
    "sentinelone": {
      "command": "bash",
      "args": [
        ".claude/mcp/with-op-env.sh",
        "PURPLEMCP_CONSOLE_TOKEN", "PURPLEMCP_CONSOLE_BASE_URL",
        "--",
        "uvx", "--from", "./third_party/purple-mcp", "purple-mcp", "--mode", "stdio"
      ]
    },
    "latent-defense": {
      "command": "bash",
      "args": [
        ".claude/mcp/with-op-env.sh",
        "LATENT_DEFENSE_URL", "LATENT_DEFENSE_API_KEY",
        "--",
        "latent-defense-mcp"
      ]
    }
  }
}
